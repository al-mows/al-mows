# ---------------------------------------------------------------------------
# Al Mows Blocks — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values before deployment.
# Never commit `.env.local` — it is git-ignored.
#
# The quote form (POST /api/quote) sends enquiry emails via Resend.
# Without RESEND_API_KEY the API returns a controlled error and the site
# still runs; it simply cannot deliver email until the key is set.
# ---------------------------------------------------------------------------

# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where quote enquiries are delivered.
QUOTE_RECIPIENT_EMAIL=al.mows@outlook.com

# The verified "from" address for outgoing enquiry emails.
# Must be an address on a domain verified in your Resend account,
# e.g. quotes@almowsblocks.com.au
QUOTE_FROM_EMAIL=
